  afterLines:
  - speaker: ISABELLE
    text: Evelyn, have you seen Celeste?
  beforeChoices: []
  afterChoices:
  - response: Not since this morning.
    reply: 'ISABELLE: I hope she''s all right.'
    suspicionChange: 0
  - response: She said she was going to the library.
    reply: 'ISABELLE: I''ll look there.'
    suspicionChange: -5
  - response: Why would I know?
    reply: 'ISABELLE: I only asked.'
    suspicionChange: 10
  beforeCeleste: 1
  afterCeleste: 1
  oneTimeBefore: 1
  oneTimeAfter: 0
